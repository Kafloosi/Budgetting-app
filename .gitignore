# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
.gstack/

# gstack is cloned + built locally by scripts/setup-gstack.sh (~1.6 GB).
# The per-skill folders beside it are symlinks into that clone, so they are
# generated too — committing them would leave broken links in a fresh checkout.
.claude/skills/*

# impeccable is the exception: 123 real files, no symlinks, ~3 MB. It is
# committed so a new session has /impeccable with nothing to install.
!.claude/skills/impeccable/

# Machine-local settings, and the byte-identical GitHub Copilot copy of the
# impeccable skill — regenerate both with `npx impeccable install`.
.claude/settings.local.json
.github/skills/
.github/hooks/
